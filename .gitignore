# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/

# ─── Build outputs ────────────────────────────────────────────────────────────
.next/
frontend/.next/
out/
frontend/out/
dist/
frontend/dist/
.vite/
frontend/.vite/

# ─── Uploaded & generated files ───────────────────────────────────────────────
# Never commit user data or generated reports
uploads/

# ─── Environment variables ────────────────────────────────────────────────────
# Root level
.env
.env.local
.env.*.local

# Frontend
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Keep example templates
!.env.example
!frontend/.env.example

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Secrets and signing keys (never commit) ──────────────────────────────────
key.md
*.pem
*.keystore
*.jks

# ─── Generated build / lint output ────────────────────────────────────────────
frontend/lint-error.txt
frontend/android/build-log.txt
frontend/android/build-out.txt

# ─── OS / Editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Internal planning docs — not part of the public repo
plan/
*.md
!README.md
!.github/**/*.md