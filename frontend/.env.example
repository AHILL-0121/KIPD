# Database
DATABASE_URL=postgresql://user:password@host/database

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Razorpay (online payment links and UPI QR codes)
# (Removed: RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET. Each business now connects its own
# Razorpay account in Settings > Payments; nothing platform-wide is read from the environment.)

# Encrypts each business's Razorpay keys before they are stored. Any random string of 32+ characters, for example
# the output of: openssl rand -base64 48
# Keep it safe and never change it: if it is lost or changed, every business has to re-enter its keys.
PAYMENT_KEYS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Email (SMTP). Used for staff invitations and access requests.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kipd <no-reply@example.com>"
# Where the public "request access" form is delivered
CONTACT_ADMIN_EMAIL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_xxx

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
